{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "R-03: image digests in workflow strings, which Dependabot cannot see. Dependabot keeps actions, npm and the Dockerfile.",
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "image:tag@sha256:digest in workflows",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9._/-]*[a-z0-9]):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "minimumReleaseAge": "7 days",
  "schedule": [
    "* 0-6 * * 1"
  ],
  "groupName": "pins"
}
